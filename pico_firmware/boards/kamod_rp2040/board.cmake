set(PICO_BOARD "pico" CACHE STRING "Pico SDK board")
set(PICO_PLATFORM "rp2040" CACHE STRING "Pico SDK platform")
if(NOT PICO_BOARD STREQUAL "pico" OR NOT PICO_PLATFORM STREQUAL "rp2040")
    message(FATAL_ERROR "kamod_rp2040 requires PICO_BOARD=pico and PICO_PLATFORM=rp2040")
endif()

function(relobot_add_board)
    set(board_dir "${RELOBOT_PICO_ROOT}/boards/kamod_rp2040")
    add_library(relobot_board STATIC "${board_dir}/board.c")
    target_include_directories(relobot_board PUBLIC "${RELOBOT_PICO_ROOT}/include")
    target_include_directories(relobot_board PRIVATE "${board_dir}")
    pico_generate_pio_header(relobot_board "${board_dir}/kamod_ws2812.pio")
    target_link_libraries(relobot_board PUBLIC pico_stdlib hardware_pio hardware_clocks)
    target_compile_options(relobot_board PRIVATE -Wall -Wextra -Werror)
endfunction()
