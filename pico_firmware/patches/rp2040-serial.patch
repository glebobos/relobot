diff --git a/rmw_zenoh_pico/src/zenoh_pico/zenoh_pico_condition.c b/rmw_zenoh_pico/src/zenoh_pico/zenoh_pico_condition.c
index 0101c23..29ac8a9 100644
--- a/rmw_zenoh_pico/src/zenoh_pico/zenoh_pico_condition.c
+++ b/rmw_zenoh_pico/src/zenoh_pico/zenoh_pico_condition.c
@@ -42,6 +42,20 @@ z_result_t z_condvar_timewait(z_loaned_condvar_t *cv, z_loaned_mutex_t *mp, stru
 
   return ret;
 }
+#elif defined(ZENOH_RPI_PICO)
+
+z_result_t z_condvar_init_with_attr(z_owned_condvar_t *cv, pthread_condattr_t *attr){
+  (void)attr;
+  return z_condvar_init(cv);
+}
+
+z_result_t z_condvar_timewait(z_loaned_condvar_t *cv, z_loaned_mutex_t *mp, struct timespec *wait_timeout){
+  z_clock_t abstime = z_clock_now();
+  uint64_t timeout_ms = (uint64_t)wait_timeout->tv_sec * 1000U +
+                        (uint64_t)wait_timeout->tv_nsec / 1000000U;
+  z_clock_advance_ms(&abstime, (unsigned long)timeout_ms);
+  return z_condvar_wait_until(cv, mp, &abstime);
+}
 #else
 #error "Unsupported platform"
 #endif
