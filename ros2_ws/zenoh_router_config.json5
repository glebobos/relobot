{
  mode: "router",
  listen: {
    endpoints: [
      "tcp/0.0.0.0:7447",
      "serial//hostdev/serial/by-id/usb-Raspberry_Pi_Pico_4150323038323712-if00#baudrate=115200"
    ]
  },
  transport: {
    link: {
      tx: {
        queue: {
          size: {
            control: 8,
            real_time: 8,
            interactive_high: 8,
            interactive_low: 4,
            data_high: 4,
            data: 8,
            data_low: 2,
            background: 2
          }
        }
      }
    }
  },
  scouting: {
    multicast: {
      enabled: true
    },
    gossip: {
      enabled: true,
      multihop: false
    }
  }
}
