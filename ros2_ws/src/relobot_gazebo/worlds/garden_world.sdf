<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="garden_world">
    <physics name="5ms" type="ignored">
      <max_step_size>0.005</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- World Systems Plugins -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics" />
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands" />
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster" />
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu" />
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact" />

    <!-- Lighting -->
    <light type="directional" name="sun">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 15 0 0 0</pose>
      <diffuse>0.9 0.9 0.85 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <direction>-0.4 0.2 -0.9</direction>
    </light>

    <!-- Grass Lawn Ground Plane -->
    <model name="lawn_ground">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>30 30</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>1.2</mu>
                <mu2>1.2</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>30 30</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.2 0.5 0.2 1</ambient>
            <diffuse>0.25 0.55 0.2 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Perimeter Fences (16m x 12m yard) -->
    <!-- North Wall -->
    <model name="fence_north">
      <static>true</static>
      <pose>0 6 0.5 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>16 0.2 1.0</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>16 0.2 1.0</size></box></geometry>
          <material><ambient>0.6 0.4 0.2 1</ambient><diffuse>0.6 0.4 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- South Wall -->
    <model name="fence_south">
      <static>true</static>
      <pose>0 -6 0.5 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>16 0.2 1.0</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>16 0.2 1.0</size></box></geometry>
          <material><ambient>0.6 0.4 0.2 1</ambient><diffuse>0.6 0.4 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- East Wall -->
    <model name="fence_east">
      <static>true</static>
      <pose>8 0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.2 12 1.0</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>0.2 12 1.0</size></box></geometry>
          <material><ambient>0.6 0.4 0.2 1</ambient><diffuse>0.6 0.4 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- West Wall -->
    <model name="fence_west">
      <static>true</static>
      <pose>-8 0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.2 12 1.0</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>0.2 12 1.0</size></box></geometry>
          <material><ambient>0.6 0.4 0.2 1</ambient><diffuse>0.6 0.4 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Tree 1 -->
    <model name="tree_1">
      <static>true</static>
      <pose>3 2 1.0 0 0 0</pose>
      <link name="trunk">
        <collision name="col"><geometry><cylinder><radius>0.25</radius><length>2.0</length></cylinder></geometry></collision>
        <visual name="vis">
          <geometry><cylinder><radius>0.25</radius><length>2.0</length></cylinder></geometry>
          <material><ambient>0.4 0.25 0.1 1</ambient><diffuse>0.4 0.25 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Tree 2 -->
    <model name="tree_2">
      <static>true</static>
      <pose>-3 -2 1.0 0 0 0</pose>
      <link name="trunk">
        <collision name="col"><geometry><cylinder><radius>0.3</radius><length>2.0</length></cylinder></geometry></collision>
        <visual name="vis">
          <geometry><cylinder><radius>0.3</radius><length>2.0</length></cylinder></geometry>
          <material><ambient>0.4 0.25 0.1 1</ambient><diffuse>0.4 0.25 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Flower Bed / Obstacle -->
    <model name="flower_bed">
      <static>true</static>
      <pose>2 -3 0.25 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>2.5 1.5 0.5</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>2.5 1.5 0.5</size></box></geometry>
          <material><ambient>0.7 0.3 0.2 1</ambient><diffuse>0.7 0.3 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Patio / Shed Area -->
    <model name="garden_shed">
      <static>true</static>
      <pose>-5 3 1.0 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>2.5 2.5 2.0</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>2.5 2.5 2.0</size></box></geometry>
          <material><ambient>0.5 0.5 0.5 1</ambient><diffuse>0.5 0.5 0.5 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Charging Station / Base Station Dock -->
    <!-- Charging Station / Base Station Dock (Head-First Docking) -->
    <model name="docking_station">
      <static>true</static>
      <pose>0.0 0.0 0.0 0 0 0</pose>
      <link name="station_link">
        <!-- Base Parking Tray (visual on ground) -->
        <visual name="vis_tray">
          <pose>0.20 0.0 0.005 0 0 0</pose>
          <geometry><box><size>0.75 0.55 0.01</size></box></geometry>
          <material><ambient>0.2 0.2 0.22 1</ambient><diffuse>0.25 0.25 0.28 1</diffuse></material>
        </visual>

        <!-- Station Tower (in front of robot head) -->
        <collision name="col_tower">
          <pose>0.60 0.0 0.22 0 0 0</pose>
          <geometry><box><size>0.15 0.55 0.44</size></box></geometry>
        </collision>
        <visual name="vis_tower">
          <pose>0.60 0.0 0.22 0 0 0</pose>
          <geometry><box><size>0.15 0.55 0.44</size></box></geometry>
          <material><ambient>0.15 0.15 0.18 1</ambient><diffuse>0.2 0.2 0.25 1</diffuse></material>
        </visual>

        <!-- Canopy / Roof Overhang -->
        <visual name="vis_roof">
          <pose>0.45 0.0 0.44 0 0 0</pose>
          <geometry><box><size>0.25 0.55 0.02</size></box></geometry>
          <material><ambient>0.12 0.12 0.15 1</ambient><diffuse>0.18 0.18 0.22 1</diffuse></material>
        </visual>

        <!-- AprilTag / Visual Docking Target Face (facing -X towards front camera) -->
        <visual name="vis_tag_panel">
          <pose>0.52 0.0 0.25 0 0 0</pose>
          <geometry><box><size>0.01 0.18 0.18</size></box></geometry>
          <material><ambient>0.95 0.95 0.95 1</ambient><diffuse>1.0 1.0 1.0 1</diffuse></material>
        </visual>
        <visual name="vis_tag_center">
          <pose>0.514 0.0 0.25 0 0 0</pose>
          <geometry><box><size>0.005 0.12 0.12</size></box></geometry>
          <material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.05 0.05 0.05 1</diffuse></material>
        </visual>

        <!-- Charging Contacts (facing robot front bumper) -->
        <visual name="vis_contact_left">
          <pose>0.52 0.06 0.12 0 0 0</pose>
          <geometry><box><size>0.015 0.03 0.06</size></box></geometry>
          <material><ambient>0.9 0.7 0.1 1</ambient><diffuse>1.0 0.8 0.2 1</diffuse></material>
        </visual>
        <visual name="vis_contact_right">
          <pose>0.52 -0.06 0.12 0 0 0</pose>
          <geometry><box><size>0.015 0.03 0.06</size></box></geometry>
          <material><ambient>0.9 0.7 0.1 1</ambient><diffuse>1.0 0.8 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
